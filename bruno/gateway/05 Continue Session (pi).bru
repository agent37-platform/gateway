meta {
  name: 05 Continue Session (pi)
  type: http
  seq: 54
}

post {
  url: {{baseUrl}}/v1/responses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "session_id": "{{piSessionId}}",
    "input": "In one short sentence, what did I just ask you to say?",
    "agent": "pi",
    "reasoning_effort": "low"
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("same session, completed", function () {
    expect(res.body.session_id).to.equal(bru.getEnvVar("piSessionId"));
    expect(res.body.status).to.equal("completed");
    expect(res.body.agent).to.equal("pi");
  });
}

docs {
  Continue a Pi conversation. Reuses `piSessionId` saved by "04 Create
  Response (pi)". Always include `"agent": "pi"` so the gateway routes the
  turn to the right backend.
}
