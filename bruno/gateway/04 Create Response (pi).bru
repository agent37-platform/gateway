meta {
  name: 04 Create Response (pi)
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/v1/responses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": "What is the time now in IST?",
    "agent": "pi",
    "reasoning_effort": "low"
  }
}

script:post-response {
  if (res.status === 200 && res.body) {
    if (res.body.session_id) bru.setEnvVar("piSessionId", res.body.session_id, { persist: true });
    if (res.body.id) bru.setEnvVar("piResponseId", res.body.id, { persist: true });
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("completed with text", function () {
    expect(res.body.id).to.be.a("string");
    expect(res.body.session_id).to.be.a("string");
    expect(res.body.status).to.equal("completed");
    expect(res.body.agent).to.equal("pi");
    expect(res.body.output_text).to.be.a("string");
  });
}

docs {
  Start a new Pi session. Pass `"agent": "pi"`: the gateway runs Pi
  headless (`pi --mode json`), one process per turn on pi's own
  credentials. Add `"model"` to pick one of pi's `provider/id` models.

  The reply saves `piSessionId` and `piResponseId` to the environment so
  the follow-up requests below can reuse them.

  Pi must be installed on this machine (`pi` on PATH, or PI_BIN) with a
  provider credential it can resolve.
}
